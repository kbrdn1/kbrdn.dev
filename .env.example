# GitHub Personal Access Token for contribution chart
# Create one at: https://github.com/settings/tokens
# Required scopes: read:user, repo
# Supports both classic tokens (ghp_) and fine-grained tokens (github_pat_)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Resend API Key for contact form emails
# Create one at: https://resend.com/api-keys
# Optional: If not set, contact form submissions will be logged to console
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile on the contact form. Without both, /api/contact refuses every message.
# These are Cloudflare's test keys: the widget always passes, so the form works locally
# (https://developers.cloudflare.com/turnstile/troubleshooting/testing/). The real ones are
# the repo variable TURNSTILE_SITE_KEY and the secret TURNSTILE_SECRET_KEY.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Addresses of the CV PDFs, hosted outside this repository (the repo variables CV_URL_FR /
# CV_URL_EN: `gh variable get CV_URL_FR`). Empty, the CV sections of /parcours and /contact
# stay hidden
CV_URL_FR=
CV_URL_EN=
