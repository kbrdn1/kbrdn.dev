  "printWidth": 100,
  "singleQuote": true,
  "semi": false,
  "ignorePatterns": ["**/*.md", "**/*.mdx", "app/components/OgImage/**"],
  "overrides": [
    {
      "files": ["**/*.css"],
      "options": {
        "singleQuote": false
      }
    }
  ]
}
